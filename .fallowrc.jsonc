{
  "$schema": "./node_modules/fallow/schema.json",
  // Entry points need no listing: fallow's TanStack Router, Vite, Vitest,
  // oxlint, oxfmt and lefthook plugins find the routes, the configs and the
  // tests, and `exports` in each workspace `package.json` covers the packages.
  // `fallow list --entry-points --plugins` shows what it picked up.
  //
  // Flag stray exports in route files and package entries too, instead of
  // crediting every entry export as used.
  "includeEntryExports": true,
  // Generic libraries: their API (error classes, service shapes) is meant for
  // callers this repo does not have yet.
  "publicPackages": ["@ntatoud/effect-collections", "@ntatoud/effect-markdown"],
  "ignorePatterns": [
    // Markdown documents, read from disk by `@ntatoud/effect-collections`,
    // never imported.
    "content/**",
    "packages/effect-collections/test/fixtures/**",
  ],
  "ignoreExports": [
    // Generated by TanStack Router.
    { "file": "apps/web/src/routeTree.gen.ts", "exports": ["*"] },
    // shadcn primitives: keep their full export surface.
    { "file": "apps/web/src/components/ui/*.tsx", "exports": ["*"] },
    // The edge function runs on Deno and duplicates the content package's
    // negotiation helpers on purpose (ADR-0009); `test/markdown.test.ts` pins
    // the two copies together.
    {
      "file": "netlify/edge-functions/markdown-negotiation.ts",
      "exports": ["markdownPath"],
    },
  ],
  "rules": {
    // Defaults are `warn`; this repo wants them to fail CI like the rest.
    "unused-dev-dependencies": "error",
    "unused-catalog-entries": "error",
    "stale-suppressions": "error",
    "require-suppression-reason": "error",
    // Without coverage data CRAP is estimated as if nothing were tested, which
    // flags every React component with a couple of conditionals. Cyclomatic
    // and cognitive complexity still fail CI.
    "complexity-crap": "warn",
  },
  "duplicates": {
    "ignore": [
      "**/routeTree.gen.ts",
      // Same ADR-0009 duplication as above, at the function level.
      "netlify/edge-functions/**",
    ],
    // RSS `<item>` vs Atom `<entry>` in `features/feed/feed.ts`: the same
    // shape for two different formats, not copy-paste worth sharing.
    "ignoredClones": ["dup:04af141d:2"],
  },
  "health": {
    "ignore": ["**/routeTree.gen.ts"],
    "thresholdOverrides": [
      {
        "files": [
          "packages/content/vite-markdown.ts",
          "netlify/edge-functions/markdown-negotiation.ts",
        ],
        "functions": ["prefersMarkdown"],
        "maxCognitive": 17,
        "reason": "Accept-header parser, kept flat so the Node and Deno copies stay line-for-line identical (ADR-0009)",
      },
    ],
  },
}
