{
  "$schema": "./node_modules/fallow/schema.json",
  // No entry list: fallow's plugins find them (`fallow list --entry-points --plugins`). Entry exports still get checked.
  "includeEntryExports": true,
  // Generic libraries: their API is meant for callers this repo does not have yet.
  "publicPackages": ["@ntatoud/effect-collections", "@ntatoud/effect-markdown"],
  "ignorePatterns": [
    // Read from disk, never imported.
    "content/**",
    "packages/effect-collections/test/fixtures/**",
  ],
  "ignoreExports": [
    { "file": "apps/web/src/routeTree.gen.ts", "exports": ["*"] },
    { "file": "apps/web/src/components/ui/*.tsx", "exports": ["*"] },
    // Loaded by `oxlint.config.ts` as a path string.
    { "file": "packages/oxlint-plugin/index.ts", "exports": ["default"] },
    // Deno duplicate of the content package's helpers, on purpose (ADR-0009).
    {
      "file": "netlify/edge-functions/markdown-negotiation.ts",
      "exports": ["markdownPath"],
    },
  ],
  "rules": {
    // Defaults are `warn`; these fail CI like the rest.
    "unused-dev-dependencies": "error",
    "unused-catalog-entries": "error",
    "stale-suppressions": "error",
    "require-suppression-reason": "error",
    // Without coverage data CRAP flags every React component with a couple of conditionals.
    "complexity-crap": "warn",
  },
  "duplicates": {
    "ignore": ["**/routeTree.gen.ts", "netlify/edge-functions/**"],
    // RSS `<item>` vs Atom `<entry>`: same shape, two formats, not worth sharing.
    "ignoredClones": ["dup:ac467462:2"],
  },
  "health": {
    "ignore": ["**/routeTree.gen.ts"],
    "thresholdOverrides": [
      {
        "files": [
          "packages/content/vite-markdown.ts",
          "netlify/edge-functions/markdown-negotiation.ts",
        ],
        "functions": ["prefersMarkdown"],
        "maxCognitive": 17,
        "reason": "Accept-header parser, kept flat so the Node and Deno copies stay line-for-line identical (ADR-0009)",
      },
    ],
  },
}
