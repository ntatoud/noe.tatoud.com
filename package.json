{
  "name": "noe.tatoud.com",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @ntatoud/web dev",
    "build": "pnpm --filter @ntatoud/web build",
    "lint": "oxlint --config oxlint.config.ts",
    "format": "oxfmt",
    "check": "oxfmt --check . && oxlint --config oxlint.config.ts",
    "knip": "knip",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "knip": "6.26.0",
    "lefthook": "2.1.10",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.26.0"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ]
  }
}
