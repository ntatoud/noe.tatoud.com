{
  "name": "noe.tatoud.com",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @ntatoud/web dev",
    "build": "pnpm --filter @ntatoud/web build",
    "lint": "oxlint --config oxlint.config.ts",
    "format": "oxfmt",
    "check": "oxfmt --check . && oxlint --config oxlint.config.ts",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r typecheck",
    "knip": "knip",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@netlify/edge-functions": "catalog:",
    "@shadcn/lint": "catalog:",
    "@types/node": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.26.0"
  },
  "packageManager": "pnpm@10.34.5"
}
