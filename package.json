{
  "name": "noe.tatoud.com",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @ntatoud/web dev",
    "build": "pnpm --filter @ntatoud/web build",
    "lint": "oxlint --config oxlint.config.ts",
    "format": "oxfmt",
    "check": "oxfmt --check . && oxlint --config oxlint.config.ts",
    "test": "pnpm -r --if-present test",
    "knip": "knip",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@netlify/edge-functions": "4.0.0",
    "@types/node": "catalog:",
    "knip": "6.34.0",
    "lefthook": "2.1.12",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.26.0"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ],
    "patchedDependencies": {
      "@tanstack/start-plugin-core@1.171.40": "patches/@tanstack__start-plugin-core@1.171.40.patch"
    }
  }
}
