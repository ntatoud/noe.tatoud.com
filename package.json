{
  "name": "noe.tatoud.com",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @ntatoud/web dev",
    "build": "pnpm --filter @ntatoud/web build",
    "lint": "oxlint --config oxlint.config.ts",
    "format": "oxfmt",
    "check": "oxfmt --check . && oxlint --config oxlint.config.ts",
    "knip": "knip",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@content-collections/cli": "0.1.9",
    "knip": "6.7.0",
    "lefthook": "2.1.6",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@10.26.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ]
  }
}
